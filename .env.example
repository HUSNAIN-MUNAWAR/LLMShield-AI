APP_ENV=development
DATABASE_URL=sqlite:///./llmshield.db
REDIS_URL=redis://redis:6379/0
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
ENABLE_DEMO_TARGETS=true
ALLOW_PRIVATE_TARGETS=false
ENDPOINT_ALLOWLIST=localhost,127.0.0.1
SCAN_TIMEOUT_SECONDS=30
MAX_PROMPT_CHARS=6000
MAX_RESPONSE_BYTES=200000
JWT_SECRET=change-me-for-local-only
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

SCAN_EXECUTION_MODE=sync
API_KEY_PREFIX=lsk
ACCESS_TOKEN_MINUTES=240
REFRESH_TOKEN_MINUTES=10080
